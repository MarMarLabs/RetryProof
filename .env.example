# Server-only OpenAI credential. Never expose this with a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=
OPENAI_ORGANIZATION_ID=
OPENAI_PROJECT_ID=
OPENAI_ANALYSIS_MODEL=gpt-5.6-sol
CODEX_MODEL=gpt-5.6-sol

# Optional production persistence. Without this value RetryProof uses its
# deterministic ephemeral store for local development and the seeded judge path.
DATABASE_URL=

# At least 32 random bytes in production. Development derives an ephemeral value.
SESSION_SIGNING_SECRET=

# cached | live. Cached keeps the seeded demo independent from model availability.
DEMO_MODEL_MODE=cached
CODEX_REPAIR_MODE=cached
# Trusted local development only. Production rejects live Codex repair.
CODEX_ALLOW_LOCAL_LIVE=false
